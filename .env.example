# Live detection & selection toggles (overridable live via POST /api/config)
DETECT_EDITS=true
DETECT_IMAGES=false
SUMMARIZE=false
DETECT_EXCLUDE_BOTS=true
DETECT_ONLY_ANON=false

# Ingestor settings
SAMPLE_RATE=1.0
STREAM_MAXLEN=200
FLUSH_INTERVAL_S=1.0

# Wikimedia API contact (policy requires real contact info; replace placeholder)
USER_AGENT=WikiPulse/1.0 (contact@example.com)
MAX_FETCHES_PER_MIN=180

# Default universal CPU LLM settings (Gemma 4 E4B mobile Q2 QAT via llama.cpp)
LLM_HF_REPO=unsloth/gemma-4-E4B-it-qat-mobile-GGUF:UD-Q2_K_XL
LLM_MODEL=gemma-4-e4b-qat
LLM_THREADS=8
LLM_CTX_SIZE=4096
LLM_PARALLEL=1
ANALYZER_CONCURRENCY=1
LLM_TIMEOUT_S=60

# NVIDIA CUDA override settings (used with docker-compose.gpu.yml)
LLM_GPU_HF_REPO=unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
LLM_GPU_LAYERS=99
LLM_GPU_CTX_SIZE=16384
LLM_GPU_PARALLEL=4
LLM_GPU_CONCURRENCY=4
LLM_GPU_TIMEOUT_S=45

# Optional Hugging Face token (not needed for public Unsloth GGUF repos)
HF_TOKEN=

# Logging
LOG_LEVEL=INFO
